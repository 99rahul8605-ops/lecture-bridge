# The bridge is running alongside your Ubuntu login web UI on PORT 8090.
# DO NOT put actual secrets into GitHub.
RELAY_PUBLIC_BASE_URL=https://ubuntu-production-9d09.up.railway.app
RELAY_ALLOWED_ORIGIN=https://vidcloud.eu.org
RELAY_REQUIRE_UPLOAD_KEY=0
RELAY_MAX_JOBS=1
RELAY_MAX_GB=0.7
RELAY_TTL_HOURS=2

# Telegram credentials for your EXISTING bot; add actual values only to the PRIVATE .env on server.
BOT_TOKEN=YOUR_EXISTING_BOT_TOKEN
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH
TELEGRAM_CHAT_ID=YOUR_NUMERIC_CHAT_ID_OR_PUBLIC_USERNAME
